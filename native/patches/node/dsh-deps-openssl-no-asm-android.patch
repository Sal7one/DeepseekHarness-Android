OpenSSL: build without asm on Android (like upstream android-configure's
--openssl-no-asm) but only for the openssl targets, so the global
OPENSSL_NO_ASM define doesn't force a full rebuild. The aarch64 perlasm
crashed in the app process (x18 is the platform register on Android).

--- a/deps/openssl/openssl.gyp
+++ b/deps/openssl/openssl.gyp
@@ -32,7 +32,7 @@
       'conditions': [
         [ 'openssl_no_asm==1', {
           'includes': ['./openssl_no_asm.gypi'],
-        }, 'target_arch=="arm64" and OS=="win"', {
+        }, 'target_arch=="arm64" and OS in "win android"', {
           # VC-WIN64-ARM inherits from VC-noCE-common that has no asms.
           'includes': ['./openssl_no_asm.gypi'],
         }, 'gas_version and v(gas_version) >= v("2.26") or '
@@ -77,7 +77,7 @@
       'conditions': [
         ['openssl_no_asm==1', {
           'includes': ['./openssl-cl_no_asm.gypi'],
-        }, 'target_arch=="arm64" and OS=="win"', {
+        }, 'target_arch=="arm64" and OS in "win android"', {
           # VC-WIN64-ARM inherits from VC-noCE-common that has no asms.
           'includes': ['./openssl-cl_no_asm.gypi'],
         }, {
@@ -111,7 +111,7 @@
       'conditions': [
         [ 'openssl_no_asm==1', {
           'includes': ['./openssl-fips_no_asm.gypi'],
-        }, 'target_arch=="arm64" and OS=="win"', {
+        }, 'target_arch=="arm64" and OS in "win android"', {
           # VC-WIN64-ARM inherits from VC-noCE-common that has no asms.
           'includes': ['./openssl-fips_no_asm.gypi'],
         }, 'gas_version and v(gas_version) >= v("2.26") or '
