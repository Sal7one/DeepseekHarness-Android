zlib: on Android use the Linux getauxval()/HWCAP CPU detection instead of the
NDK cpufeatures library (its header is not on the include path; Termux avoids
this by using a shared zlib). bionic arm64 provides getauxval since API 18.

--- a/deps/zlib/zlib.gyp	2026-10-27 17:22:41.337343727 -0400
+++ b/deps/zlib/zlib.gyp	2026-10-27 17:22:41.344788954 -0400
@@ -73,7 +73,7 @@
                   'cflags': [ '-march=armv8-a+aes+crc' ],
                 }],
                 ['OS=="android"', {
-                  'defines': [ 'ARMV8_OS_ANDROID' ],
+                  'defines': [ 'ARMV8_OS_LINUX' ],
                 }],
                 ['OS=="linux" or OS=="openharmony"', {
                   'defines': [ 'ARMV8_OS_LINUX' ],
@@ -91,7 +91,7 @@
