<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds: GWP-ASan on every allocation-sampling slot in all processes (incl. :engine), so heap
     corruption (suspected in native addons / OpenSSL) produces a precise tombstone "Cause:" line. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application android:gwpAsanMode="always" tools:targetApi="30" />
</manifest>
